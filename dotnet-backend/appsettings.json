{
  "ConnectionStrings": {
    "MySql": "Server=${DB_HOST};Port=3306;Database=${DB_NAME};User ID=${DB_USER};Password=${DB_PASSWORD};SslMode=Preferred;Allow User Variables=True;"
  },
  "Jwt": {
    "Issuer": "relayforge",
    "Audience": "relayforge-panel",
    "LifetimeMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Panel": {
    "InstallScriptUrl": "https://github.com/WayneDuan/RelayForge-Release/releases/latest/download/install.sh",
    "WindowsInstallScriptUrl": "https://github.com/WayneDuan/RelayForge-Release/releases/latest/download/install-windows.ps1",
    "ReleaseBaseUrl": "https://github.com/WayneDuan/RelayForge-Release/releases/latest/download",
    "ChecksumsUrl": "https://github.com/WayneDuan/RelayForge-Release/releases/latest/download/checksums.txt",
    "RequireHttps": true
  },
  "Security": {
    "AllowLegacyQuerySecrets": false,
    "MaxRequestBodyBytes": 1048576
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
